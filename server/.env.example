NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/bizlaunch
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# Gmail: enable 2-Step Verification and generate an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Explicit additional trusted frontend origins, comma-separated.
# In production list only your deployed frontend origins.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional cloud image hosting; leave empty to use local uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=